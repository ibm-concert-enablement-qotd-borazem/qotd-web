<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="icon" type="/image/png" href="/images/hybridcloud.png">
    <link rel="stylesheet" href="/css/home.css">
    <style>
        p {
            padding-top: 1em;
        }
    </style>
    <title>Quote of the Day Author Bio</title>

</head>

<body>

    <main role="main">

        <div class="container">
            <div class="row">
                <div class="col-12">
                    <a href="/"><button class="btn btn-outline-dark float-left">Home</button></a>
                </div>
            </div>

            <div class="row" style="padding-top: 2em;">
                <div class="col-md-3">
                    <img id="author_image" src="/images/<%=author_id%>" class="img-fluid">
                </div>
                <div class="col-md-9">
                    <%- bio %>
                </div>
            </div>

            <div class="row" style="padding-top: 5em;">
                <div class="col-12">
                    <a href="https://www.wikipedia.org/" class="text-muted">Information and images graciously scraped
                        from Wikipeadia</a>
                </div>
            </div>

        </div>


    </main>


</body>

</html>