{
    "id": "incident",
    "name": "Simulated incident record",
    "template": "Disk status notifier: code=D{{v1}} dstepid={{v2}} vd={{user}}",
    "fields": {
        "v1": {
            "type": "randomInt",
            "min": 1000,
            "max": 9999
        },
        "v2": {
            "type": "randomInt",
            "min": 1000,
            "max": 9999
        },
        "user": {
            "type": "userName"
        }
    },
    "repeat": {
        "mean": 13000,
        "stdev": 200,
        "min": 11000,
        "max": 15000
    }
}